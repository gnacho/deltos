{
  "compilerOptions": {
    "target": "ES2019",
    "module": "es2020",
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "removeComments": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
