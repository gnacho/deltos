{
  "name": "deltos-server",
  "version": "2.6.48",
  "description": "Backend de Deltos — PWA de gestión de tareas para pareja (Hono + better-sqlite3)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json && node --watch dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.0",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "cookie": "1.1.1",
    "hono": "^4.13.12",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
