# Deltos — configuración del servidor (copiar a .env y ajustar)

# Puerto del servidor (API + estáticos en el mismo puerto, sin CORS)
PORT=3000

# Directorio de datos: app.db (producción), app_demo.db (demo) y uploads/
DATA_DIR=./data

# Frontend compilado (vite build de ../app). El servidor hace SPA fallback.
STATIC_DIR=../app/dist

# Secret HMAC de la cookie de sesión (mínimo 32 caracteres).
# Si se omite, se autogenera y persiste en la tabla kv (sobrevive reinicios).
# SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# Bootstrap del primer admin (solo se crea si no existe; luego se gestiona en BD)
AUTH_USER=admin
AUTH_PASS=cambia-esta-password

# 'true' solo detrás de HTTPS (reverse proxy). En dev con http://localhost: false.
# Activa el flag Secure de la cookie y el header HSTS.
COOKIE_SECURE=false

# Máximo de clientes SSE simultáneos (protección DoS)
MAX_SSE_CLIENTS=20

# Tamaño máximo de adjunto en MB
MAX_UPLOAD_MB=10
